<Window x:Class="MClauncher.SplashScreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nexus Launcher"
        Width="520"
        Height="280"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        Topmost="True">
    <Border CornerRadius="18" BorderThickness="1" Padding="24">
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#4062EFAD" Offset="0"/>
                <GradientStop Color="#407C4DFF" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0C1020" Offset="0"/>
                <GradientStop Color="#111830" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Border Width="46" Height="46" CornerRadius="12" Margin="0,0,12,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#1a6b30" Offset="0"/>
                                <GradientStop Color="#2a9d4a" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="N" FontSize="24" FontWeight="Black" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="NEXUS LAUNCHER" Foreground="White" FontSize="26" FontWeight="Black"/>
                        <TextBlock Text="Preparing your Minecraft experience" Foreground="#9DB3D1" FontSize="11" Margin="1,4,0,0"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <ProgressBar Grid.Row="1" Height="7" Margin="0,14,0,10" IsIndeterminate="True"/>

            <TextBlock Grid.Row="2" x:Name="txtStatus" Text="Starting..." FontSize="12" Foreground="#AFC1D9" HorizontalAlignment="Center"/>
        </Grid>
    </Border>
</Window>
