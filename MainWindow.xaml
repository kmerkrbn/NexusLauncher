<ui:FluentWindow x:Class="MClauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:MClauncher"
        mc:Ignorable="d"
        Title="Nexus Launcher"
        Height="680" Width="1100"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">

    <ui:FluentWindow.Resources>
        <!-- Custom TitleBar style -->
        <Style x:Key="CustomTitleBarStyle" TargetType="ui:TitleBar">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════
             PREMIUM TITLE BAR
             ═══════════════════════════════════════ -->
        <Grid Grid.Row="0">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#080C18" Offset="0"/>
                    <GradientStop Color="#0A0E20" Offset="0.5"/>
                    <GradientStop Color="#080C18" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>

            <!-- Bottom border line with gradient -->
            <Border VerticalAlignment="Bottom" Height="1">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="Transparent" Offset="0"/>
                        <GradientStop Color="#3062EFAD" Offset="0.3"/>
                        <GradientStop Color="#5062EFAD" Offset="0.5"/>
                        <GradientStop Color="#3062EFAD" Offset="0.7"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <Border Height="36" VerticalAlignment="Top" Background="Transparent" MouseLeftButtonDown="TopBar_MouseLeftButtonDown">
                <Grid Margin="10,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- App Icon -->
                        <Border Width="22" Height="22" CornerRadius="6" Margin="0,0,8,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#1a6b30" Offset="0"/>
                                    <GradientStop Color="#2a9d4a" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="6" Color="#4CAF50" Opacity="0.5" ShadowDepth="0"/>
                            </Border.Effect>
                            <TextBlock Text="N" FontSize="12" FontWeight="Black" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Title -->
                        <TextBlock Text="NEXUS" FontSize="12" FontWeight="Black" Foreground="White"
                                   VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock Text="LAUNCHER" FontSize="12" FontWeight="Black" VerticalAlignment="Center">
                            <TextBlock.Foreground>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#62EFAD" Offset="0"/>
                                    <GradientStop Color="#00B4D8" Offset="1"/>
                                </LinearGradientBrush>
                            </TextBlock.Foreground>
                        </TextBlock>

                        <!-- Version badge -->
                        <Border Background="#1562EFAD" BorderBrush="#3062EFAD" BorderThickness="1"
                                CornerRadius="8" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="v1.0.3" FontSize="9" FontWeight="Bold" Foreground="#62EFAD"/>
                        </Border>

                        <!-- Status dot -->
                        <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                            <Ellipse Width="5" Height="5" Fill="#4CAF50" Margin="0,0,4,0">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="4" Color="#4CAF50" Opacity="1" ShadowDepth="0"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <TextBlock Text="Online" FontSize="9" Foreground="#4CAF50" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Window controls -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0">
                        <Button x:Name="btnMinimize" Click="BtnMinimize_Click" Width="36" Height="26" Margin="0,0,4,0"
                                Background="Transparent" BorderBrush="#20FFFFFF" BorderThickness="1" Foreground="#B0C0D8"
                                FontSize="13" FontWeight="Bold" Cursor="Hand" ToolTip="Minimize">
                            <Button.Content>
                                <TextBlock Text="—" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-6,0,0"/>
                            </Button.Content>
                        </Button>

                        <Button x:Name="btnMaxRestore" Click="BtnMaxRestore_Click" Width="36" Height="26" Margin="0,0,4,0"
                                Background="Transparent" BorderBrush="#20FFFFFF" BorderThickness="1" Foreground="#B0C0D8"
                                FontSize="11" FontWeight="Bold" Cursor="Hand" ToolTip="Maximize / Restore">
                            <Button.Content>
                                <TextBlock Text="▢" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button.Content>
                        </Button>

                        <Button x:Name="btnClose" Click="BtnClose_Click" Width="36" Height="26"
                                Background="#20FF5252" BorderBrush="#40FF5252" BorderThickness="1" Foreground="#FFD7D7"
                                FontSize="12" FontWeight="Bold" Cursor="Hand" ToolTip="Close">
                            <Button.Content>
                                <TextBlock Text="✕" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button.Content>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Root Frame for full-page navigation (Login → Main) -->
        <Frame Name="RootFrame" Grid.Row="1" NavigationUIVisibility="Hidden" />
    </Grid>
</ui:FluentWindow>
