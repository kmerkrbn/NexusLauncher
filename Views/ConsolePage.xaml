<Page x:Class="MClauncher.Views.ConsolePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MClauncher.Views"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="1100"
      Title="ConsolePage"
      Background="{DynamicResource ApplicationBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════
             HEADER
             ══════════════════════════════ -->
        <Border Grid.Row="0" Padding="24,20,24,16" BorderThickness="0,0,0,1">
            <Border.BorderBrush><SolidColorBrush Color="#1A2040"/></Border.BorderBrush>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Colored icon badge -->
                    <Border Width="42" Height="42" CornerRadius="11" Margin="0,0,14,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#1a1040" Offset="0"/>
                                <GradientStop Color="#2a1860" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" Color="#7C4DFF" Opacity="0.3" ShadowDepth="0"/>
                        </Border.Effect>
                        <TextBlock Text="📋" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Launch Console" FontSize="24" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Live game output and diagnostic logs" FontSize="11" Foreground="#556677" Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#1562EFAD" BorderBrush="#2562EFAD" BorderThickness="1"
                            CornerRadius="8" Padding="12,7" Margin="0,0,8,0" Cursor="Hand" x:Name="btnCopyLogs">
                        <TextBlock Text="📋 Copy All" FontSize="11" Foreground="#62EFAD"/>
                    </Border>
                    <ui:Button Name="btnClearLogs" Content="Clear" Appearance="Secondary" 
                               Padding="14,7" Click="btnClearLogs_Click" FontSize="12">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Delete24"/>
                        </ui:Button.Icon>
                    </ui:Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════════════════════
             TERMINAL AREA
             ══════════════════════════════ -->
        <Border Grid.Row="1" Margin="24,16,24,24" CornerRadius="14" ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" Color="#000000" Opacity="0.4" ShadowDepth="0"/>
            </Border.Effect>
            <Grid>
                <!-- Terminal background -->
                <Border>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#090D17" Offset="0"/>
                            <GradientStop Color="#060A12" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- Top window bar (macOS style) -->
                <Border VerticalAlignment="Top" Padding="14,10" BorderThickness="0,0,0,1">
                    <Border.BorderBrush><SolidColorBrush Color="#1A2040"/></Border.BorderBrush>
                    <Border.Background><SolidColorBrush Color="#0C101E"/></Border.Background>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="10" Height="10" Fill="#FF5F57" Margin="0,0,6,0"/>
                        <Ellipse Width="10" Height="10" Fill="#FEBC2E" Margin="0,0,6,0"/>
                        <Ellipse Width="10" Height="10" Fill="#28C840"/>
                        <TextBlock Text="nexus-console — game output" FontSize="10" Foreground="#334466" 
                                   Margin="16,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Scan-line overlay (subtle) -->
                <Rectangle Opacity="0.015" IsHitTestVisible="False">
                    <Rectangle.Fill>
                        <DrawingBrush TileMode="Tile" Viewport="0,0,1,4" ViewportUnits="Absolute">
                            <DrawingBrush.Drawing>
                                <GeometryDrawing Brush="#FFFFFF">
                                    <GeometryDrawing.Geometry>
                                        <RectangleGeometry Rect="0,0,1,1"/>
                                    </GeometryDrawing.Geometry>
                                </GeometryDrawing>
                            </DrawingBrush.Drawing>
                        </DrawingBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <!-- Log TextBox -->
                <ScrollViewer Margin="0,40,0,0" VerticalScrollBarVisibility="Auto" Padding="16,10">
                    <TextBox Name="txtLogs"
                             IsReadOnly="True"
                             Background="Transparent"
                             Foreground="#62EFAD"
                             FontFamily="Cascadia Code, Consolas, Courier New"
                             FontSize="12"
                             BorderThickness="0"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Disabled"
                             AcceptsReturn="True"
                             SelectionBrush="#3062EFAD"/>
                </ScrollViewer>

                <!-- Bottom glow line -->
                <Border VerticalAlignment="Bottom" Height="1">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="Transparent" Offset="0"/>
                            <GradientStop Color="#3062EFAD" Offset="0.5"/>
                            <GradientStop Color="Transparent" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Page>
