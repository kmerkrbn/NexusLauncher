<Page x:Class="MClauncher.Views.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MClauncher.Views"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="1000"
      Title="LoginPage"
      Loaded="Page_Loaded">

    <Page.Resources>
        <!-- Floating Particle Animation -->
        <Storyboard x:Key="FloatAnim1" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="particle1" Storyboard.TargetProperty="(Canvas.Top)"
                             From="520" To="-20" Duration="0:0:8" />
            <DoubleAnimation Storyboard.TargetName="particle1" Storyboard.TargetProperty="Opacity"
                             From="0" To="0.6" Duration="0:0:2" AutoReverse="True" RepeatBehavior="Forever"/>
        </Storyboard>
        <Storyboard x:Key="FloatAnim2" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="particle2" Storyboard.TargetProperty="(Canvas.Top)"
                             From="600" To="-30" Duration="0:0:11" BeginTime="0:0:2" />
        </Storyboard>
        <Storyboard x:Key="FloatAnim3" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="particle3" Storyboard.TargetProperty="(Canvas.Top)"
                             From="580" To="-20" Duration="0:0:9" BeginTime="0:0:4" />
        </Storyboard>
        <Storyboard x:Key="FloatAnim4" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="particle4" Storyboard.TargetProperty="(Canvas.Top)"
                             From="600" To="-25" Duration="0:0:13" BeginTime="0:0:1" />
        </Storyboard>
        <Storyboard x:Key="FloatAnim5" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="particle5" Storyboard.TargetProperty="(Canvas.Top)"
                             From="550" To="-20" Duration="0:0:7" BeginTime="0:0:3" />
        </Storyboard>
        <!-- Card entrance animation -->
        <Storyboard x:Key="CardEntrance">
            <DoubleAnimation Storyboard.TargetName="loginCard" Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.8" />
            <DoubleAnimation Storyboard.TargetName="loginCard" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                             From="40" To="0" Duration="0:0:0.8">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        <!-- Title entrance -->
        <Storyboard x:Key="TitleEntrance">
            <DoubleAnimation Storyboard.TargetName="titleBlock" Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:1" BeginTime="0:0:0.2"/>
            <DoubleAnimation Storyboard.TargetName="subtitleBlock" Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.8" BeginTime="0:0:0.5"/>
        </Storyboard>
        <!-- Pulsing glow -->
        <Storyboard x:Key="GlowPulse" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="glowEllipse" Storyboard.TargetProperty="Opacity"
                             From="0.3" To="0.7" Duration="0:0:3">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Page.Resources>

    <Grid>
        <!-- Deep Space Background -->
        <Border>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0a0a1a" Offset="0" />
                    <GradientStop Color="#0d1b3e" Offset="0.4" />
                    <GradientStop Color="#0f2a1e" Offset="0.7" />
                    <GradientStop Color="#1a0d3e" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- Animated Floating Particles -->
        <Canvas ClipToBounds="True">
            <!-- Particle 1 -->
            <Ellipse x:Name="particle1" Width="8" Height="8" Canvas.Left="120" Canvas.Top="520"
                     Opacity="0.5">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#FF62EFAD" Offset="0"/>
                        <GradientStop Color="#0062EFAD" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <!-- Particle 2 -->
            <Ellipse x:Name="particle2" Width="5" Height="5" Canvas.Left="250" Canvas.Top="600"
                     Opacity="0.4">
                <Ellipse.Fill>
                    <SolidColorBrush Color="#7C4DFF"/>
                </Ellipse.Fill>
            </Ellipse>
            <!-- Particle 3 -->
            <Ellipse x:Name="particle3" Width="10" Height="10" Canvas.Left="500" Canvas.Top="580"
                     Opacity="0.35">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#FF0078D4" Offset="0"/>
                        <GradientStop Color="#000078D4" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <!-- Particle 4 -->
            <Ellipse x:Name="particle4" Width="6" Height="6" Canvas.Left="750" Canvas.Top="600"
                     Opacity="0.5">
                <Ellipse.Fill>
                    <SolidColorBrush Color="#4CAF50"/>
                </Ellipse.Fill>
            </Ellipse>
            <!-- Particle 5 -->
            <Ellipse x:Name="particle5" Width="9" Height="9" Canvas.Left="900" Canvas.Top="550"
                     Opacity="0.45">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#FFFF9800" Offset="0"/>
                        <GradientStop Color="#00FF9800" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <!-- Extra subtle stars -->
            <Ellipse Width="3" Height="3" Canvas.Left="80" Canvas.Top="50" Opacity="0.3" Fill="White"/>
            <Ellipse Width="2" Height="2" Canvas.Left="300" Canvas.Top="100" Opacity="0.25" Fill="White"/>
            <Ellipse Width="3" Height="3" Canvas.Left="620" Canvas.Top="40" Opacity="0.3" Fill="White"/>
            <Ellipse Width="2" Height="2" Canvas.Left="830" Canvas.Top="180" Opacity="0.2" Fill="White"/>
            <Ellipse Width="3" Height="3" Canvas.Left="950" Canvas.Top="70" Opacity="0.25" Fill="White"/>
            <Ellipse Width="2" Height="2" Canvas.Left="420" Canvas.Top="480" Opacity="0.2" Fill="White"/>
        </Canvas>

        <!-- Large Ambient Glow Left -->
        <Ellipse x:Name="glowEllipse" Width="700" Height="700" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-200,0,0,-300" Opacity="0.3">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#400078D4" Offset="0" />
                    <GradientStop Color="#000078D4" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- Ambient Glow Right -->
        <Ellipse Width="600" Height="600" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-200,-200,0" Opacity="0.25">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#404CAF50" Offset="0" />
                    <GradientStop Color="#004CAF50" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- Minecraft Creeper Pattern (decorative) -->
        <Grid HorizontalAlignment="Left" VerticalAlignment="Center" Margin="50,0,0,0" Opacity="0.04">
            <TextBlock Text="â–ˆâ–ˆâ–ˆâ–ˆâ–‘â–‘â–ˆâ–ˆâ–ˆâ–ˆ&#xa;â–ˆâ–ˆâ–‘â–‘â–‘â–‘â–‘â–‘â–ˆâ–ˆ&#xa;â–ˆâ–ˆâ–ˆâ–ˆâ–‘â–‘â–ˆâ–ˆâ–ˆâ–ˆ&#xa;â–‘â–‘â–ˆâ–ˆâ–ˆâ–ˆâ–ˆâ–ˆâ–ˆâ–ˆ&#xa;â–‘â–‘â–ˆâ–ˆâ–‘â–‘â–‘â–‘â–ˆâ–ˆ&#xa;â–‘â–‘â–ˆâ–ˆâ–‘â–‘â–‘â–‘â–ˆâ–ˆ" 
                       FontFamily="Consolas" FontSize="18" Foreground="Green" LineHeight="20"/>
        </Grid>

        <!-- Diamond pattern right -->
        <Grid HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,40,0" Opacity="0.04">
            <TextBlock Text="â–‘â–‘â–‘â–“â–“â–“â–‘â–‘â–‘&#xa;â–‘â–“â–“â–“â–“â–“â–“â–“â–‘&#xa;â–“â–“â–“â–“â–“â–“â–“â–“â–“&#xa;â–‘â–“â–“â–“â–“â–“â–“â–“â–‘&#xa;â–‘â–‘â–‘â–“â–“â–“â–‘â–‘â–‘" 
                       FontFamily="Consolas" FontSize="18" Foreground="#00BFFF" LineHeight="20"/>
        </Grid>

        <!-- CENTER CONTENT -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MinWidth="480">

            <!-- Title Block -->
            <StackPanel HorizontalAlignment="Center" Margin="0,0,0,30">
                <!-- Minecraft-style logo text -->
                <Grid HorizontalAlignment="Center" Margin="0,0,0,8">
                    <!-- Shadow text -->
                    <TextBlock x:Name="titleShadow" Text="NEXUS LAUNCHER" FontSize="46" FontWeight="Black" 
                               HorizontalAlignment="Center" Margin="3,3,0,0" Opacity="0.4">
                        <TextBlock.Foreground>
                            <SolidColorBrush Color="#001a00"/>
                        </TextBlock.Foreground>
                    </TextBlock>
                    <!-- Main title -->
                    <TextBlock x:Name="titleBlock" Text="NEXUS LAUNCHER" FontSize="46" FontWeight="Black" 
                               HorizontalAlignment="Center" Opacity="0">
                        <TextBlock.Foreground>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#62EFAD" Offset="0"/>
                                <GradientStop Color="#00B4D8" Offset="0.5"/>
                                <GradientStop Color="#7C4DFF" Offset="1"/>
                            </LinearGradientBrush>
                        </TextBlock.Foreground>
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="20" Color="#62EFAD" Opacity="0.5" ShadowDepth="0"/>
                        </TextBlock.Effect>
                    </TextBlock>
                </Grid>

                <TextBlock x:Name="subtitleBlock" Text="The Ultimate Minecraft Experience" 
                           FontSize="14" Foreground="#8899BB" HorizontalAlignment="Center" 
                           Opacity="0"/>
            </StackPanel>

            <!-- Login Card -->
            <Border x:Name="loginCard" CornerRadius="20" Padding="40,36,40,36" Opacity="0">
                <Border.RenderTransform>
                    <TranslateTransform Y="40"/>
                </Border.RenderTransform>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#1A1F3A" Offset="0"/>
                        <GradientStop Color="#141826" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" Color="#0078D4" Opacity="0.3" ShadowDepth="0"/>
                </Border.Effect>
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#3062EFAD" Offset="0"/>
                        <GradientStop Color="#307C4DFF" Offset="0.5"/>
                        <GradientStop Color="#300078D4" Offset="1"/>
                    </LinearGradientBrush>
                </Border.BorderBrush>
                <Border.BorderThickness>
                    <Thickness>1</Thickness>
                </Border.BorderThickness>

                <StackPanel>
                    <!-- Microsoft Login Section -->
                    <StackPanel Margin="0,0,0,28">
                        <TextBlock Text="PREMIUM LOGIN" FontSize="10" FontWeight="Bold" 
                                   Foreground="#62EFAD" Margin="0,0,0,14"/>

                        <Button x:Name="btnLoginMicrosoft" Click="btnLoginMicrosoft_Click"
                                Background="Transparent" BorderThickness="0" 
                                Padding="0" Cursor="Hand" HorizontalAlignment="Stretch">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="btnBorder" CornerRadius="12" Padding="20,16" 
                                            HorizontalAlignment="Stretch">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#0050A0" Offset="0"/>
                                                <GradientStop Color="#0078D4" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <!-- Microsoft Logo -->
                                            <Grid Grid.Column="0" Margin="0,0,14,0" VerticalAlignment="Center">
                                                <Grid Width="20" Height="20">
                                                    <Rectangle Fill="#F25022" Width="9" Height="9" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                                    <Rectangle Fill="#7FBA00" Width="9" Height="9" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                                                    <Rectangle Fill="#00A4EF" Width="9" Height="9" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                                                    <Rectangle Fill="#FFB900" Width="9" Height="9" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                                                </Grid>
                                            </Grid>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="Sign in with Microsoft" FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                                                <TextBlock Text="Minecraft Java Edition account" FontSize="10" Foreground="#AAD4FF" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                        <VisualStateManager.VisualStateGroups>
                                            <VisualStateGroup x:Name="CommonStates">
                                                <VisualState x:Name="Normal"/>
                                                <VisualState x:Name="MouseOver">
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="btnBorder" Storyboard.TargetProperty="Opacity"
                                                                         To="0.85" Duration="0:0:0.1"/>
                                                    </Storyboard>
                                                </VisualState>
                                                <VisualState x:Name="Pressed">
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="btnBorder" Storyboard.TargetProperty="Opacity"
                                                                         To="0.7" Duration="0:0:0.05"/>
                                                    </Storyboard>
                                                </VisualState>
                                            </VisualStateGroup>
                                        </VisualStateManager.VisualStateGroups>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>

                    <!-- Divider -->
                    <Grid Margin="0,0,0,26">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Height="1" VerticalAlignment="Center">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="Transparent" Offset="0"/>
                                    <GradientStop Color="#30FFFFFF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <TextBlock Grid.Column="1" Text="OR" Margin="16,0" Foreground="#445566" FontSize="11" FontWeight="Bold"/>
                        <Border Grid.Column="2" Height="1" VerticalAlignment="Center">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#30FFFFFF" Offset="0"/>
                                    <GradientStop Color="Transparent" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Grid>

                    <!-- Offline Login Section -->
                    <StackPanel>
                        <TextBlock Text="OFFLINE MODE" FontSize="10" FontWeight="Bold" 
                                   Foreground="#7C4DFF" Margin="0,0,0,14"/>

                        <!-- Username Input -->
                        <Border CornerRadius="10" Margin="0,0,0,14" BorderThickness="1">
                            <Border.BorderBrush>
                                <SolidColorBrush x:Name="inputBorderBrush" Color="#252D50"/>
                            </Border.BorderBrush>
                            <Border.Background>
                                <SolidColorBrush Color="#0D1128"/>
                            </Border.Background>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="ğŸ‘¤" FontSize="16" 
                                           VerticalAlignment="Center" Margin="16,12,10,12" Opacity="0.6"/>
                                <TextBox x:Name="txtUsername" Grid.Column="1"
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="White" CaretBrush="White"
                                         FontSize="14" Padding="0,12,16,12"
                                         VerticalAlignment="Center"
                                         GotFocus="txtUsername_GotFocus"
                                         LostFocus="txtUsername_LostFocus">
                                    <TextBox.Resources>
                                        <Style TargetType="TextBox">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="TextBox">
                                                        <ScrollViewer x:Name="PART_ContentHost" Focusable="false"
                                                                      HorizontalScrollBarVisibility="Hidden"
                                                                      VerticalScrollBarVisibility="Hidden"/>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </TextBox.Resources>
                                </TextBox>
                                <!-- Placeholder text -->
                                <TextBlock x:Name="txtPlaceholder" Grid.Column="1" Text="Enter username..."
                                           FontSize="14" Foreground="#445566" IsHitTestVisible="False"
                                           VerticalAlignment="Center" Margin="0,0,16,0"/>
                            </Grid>
                        </Border>

                        <!-- Launch Offline Button -->
                        <Button x:Name="btnLoginOffline" Click="btnLoginOffline_Click"
                                Background="Transparent" BorderThickness="0" 
                                Padding="0" Cursor="Hand" HorizontalAlignment="Stretch">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="offlineBtnBorder" CornerRadius="12" Padding="20,14"
                                            BorderThickness="1" HorizontalAlignment="Stretch">
                                        <Border.Background>
                                            <SolidColorBrush Color="#1a1035"/>
                                        </Border.Background>
                                        <Border.BorderBrush>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#7C4DFF" Offset="0"/>
                                                <GradientStop Color="#00B4D8" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.BorderBrush>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="Play Offline" FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                                                <TextBlock Text="No account required" FontSize="10" Foreground="#8899BB" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="â†’" FontSize="18" Foreground="#7C4DFF" VerticalAlignment="Center"/>
                                        </Grid>
                                        <VisualStateManager.VisualStateGroups>
                                            <VisualStateGroup x:Name="CommonStates">
                                                <VisualState x:Name="Normal"/>
                                                <VisualState x:Name="MouseOver">
                                                    <Storyboard>
                                                        <ColorAnimation Storyboard.TargetName="offlineBtnBorder"
                                                                        Storyboard.TargetProperty="Background.Color"
                                                                        To="#2a1a4a" Duration="0:0:0.15"/>
                                                    </Storyboard>
                                                </VisualState>
                                            </VisualStateGroup>
                                        </VisualStateManager.VisualStateGroups>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>

                    <!-- Remember Me -->
                    <CheckBox x:Name="chkRememberMe"
                              Content="Remember me"
                              Margin="2,14,0,0"
                              Foreground="#AFC1D9"
                              FontSize="11"
                              IsChecked="True"/>

                    <!-- Status -->
                    <TextBlock x:Name="lbStatus" Text="" Foreground="#8899BB"
                               HorizontalAlignment="Center" Margin="0,16,0,0" FontSize="12"
                               TextAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Footer -->
            <TextBlock Text="v1.0.3  â€¢  Nexus Launcher  â€¢  Not affiliated with Mojang" 
                       FontSize="10" Foreground="#2A3550" HorizontalAlignment="Center" 
                       Margin="0,16,0,0"/>
        </StackPanel>
    </Grid>
</Page>
