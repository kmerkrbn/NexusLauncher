<Page x:Class="MClauncher.Views.ModpacksPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d"
      d:DesignHeight="620" d:DesignWidth="1000"
      Title="ModpacksPage"
      Loaded="Page_Loaded">

    <Page.Resources>
        <Style x:Key="ChipStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="14,6,14,6"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0A0C1A" Offset="0"/>
                <GradientStop Color="#0C1020" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ HEADER ═══ -->
        <Border Grid.Row="0" Padding="24,18,24,14">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#0F1428" Offset="0"/>
                    <GradientStop Color="#111830" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Border Background="#1A7C4DFF" CornerRadius="6" Padding="8,3" Margin="0,0,10,0">
                            <TextBlock Text="📦 MODPACKS" FontSize="10" FontWeight="Bold" Foreground="#7C4DFF"/>
                        </Border>
                        <TextBlock Text="Powered by Modrinth" FontSize="10" Foreground="#445566" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Modpack Browser" FontSize="22" FontWeight="Bold" Foreground="White"/>
                    <TextBlock x:Name="lbSubtitle" Text="Browse and download ready-to-play modpacks" FontSize="11" Foreground="#6688AA" Margin="0,3,0,0"/>
                </StackPanel>

                <!-- Search bar -->
                <Border Grid.Column="1" CornerRadius="10" BorderThickness="1" Width="320">
                    <Border.BorderBrush>
                        <SolidColorBrush Color="#252D50"/>
                    </Border.BorderBrush>
                    <Border.Background>
                        <SolidColorBrush Color="#0D1128"/>
                    </Border.Background>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="searchBox" Grid.Column="0"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="White" CaretBrush="White"
                                 FontSize="12" Padding="14,10,8,10"
                                 VerticalAlignment="Center"
                                 KeyDown="searchBox_KeyDown">
                            <TextBox.Resources>
                                <Style TargetType="TextBox">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TextBox">
                                                <ScrollViewer x:Name="PART_ContentHost" Focusable="false"
                                                              HorizontalScrollBarVisibility="Hidden"
                                                              VerticalScrollBarVisibility="Hidden"/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TextBox.Resources>
                        </TextBox>
                        <TextBlock x:Name="searchPlaceholder" Grid.Column="0"
                                   Text="Search modpacks..." FontSize="12" Foreground="#445566"
                                   IsHitTestVisible="False" VerticalAlignment="Center" Margin="14,0,0,0"/>
                        <ui:Button x:Name="btnClearSearch" Grid.Column="1"
                                   Content="✕" Appearance="Secondary"
                                   Padding="6,6" FontSize="10" Margin="0,4,2,4"
                                   Click="btnClearSearch_Click" Visibility="Collapsed"/>
                        <ui:Button x:Name="btnSearch" Grid.Column="2"
                                   Content="🔍" Appearance="Primary"
                                   Padding="10,6" FontSize="11" Margin="0,4,4,4"
                                   Click="btnSearch_Click"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Bottom border -->
        <Border Grid.Row="0" VerticalAlignment="Bottom" Height="1" Margin="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="Transparent" Offset="0"/>
                    <GradientStop Color="#307C4DFF" Offset="0.3"/>
                    <GradientStop Color="#507C4DFF" Offset="0.5"/>
                    <GradientStop Color="#307C4DFF" Offset="0.7"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- ═══ FILTERS ROW ═══ -->
        <Border Grid.Row="1" Padding="20,12,20,12" Background="#080B18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Category chips -->
                <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                    <WrapPanel x:Name="categoryChipsPanel" Orientation="Horizontal"/>
                </ScrollViewer>

                <!-- Game version filter -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Version:" FontSize="11" Foreground="#556688" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="cbGameVersion" FontSize="11" Width="90">
                        <ComboBoxItem Content="1.21.4" IsSelected="True"/>
                        <ComboBoxItem Content="1.21.1"/>
                        <ComboBoxItem Content="1.20.6"/>
                        <ComboBoxItem Content="1.20.4"/>
                        <ComboBoxItem Content="1.20.1"/>
                        <ComboBoxItem Content="1.19.4"/>
                        <ComboBoxItem Content="1.19.2"/>
                        <ComboBoxItem Content="1.18.2"/>
                        <ComboBoxItem Content="1.16.5"/>
                        <ComboBoxItem Content="Any"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ MAIN CONTENT ═══ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="300"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Modpack list -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16,12,16,8">
                    <StackPanel x:Name="modpacksContainer">

                        <!-- Welcome panel -->
                        <Border x:Name="welcomePanel" CornerRadius="16" Padding="40,50" Margin="0,20,0,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#0F1428" Offset="0"/>
                                    <GradientStop Color="#0C1020" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.BorderBrush>
                                <LinearGradientBrush>
                                    <GradientStop Color="#207C4DFF" Offset="0"/>
                                    <GradientStop Color="#2062EFAD" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                            <Border.BorderThickness>
                                <Thickness>1</Thickness>
                            </Border.BorderThickness>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="📦" FontSize="52" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                <TextBlock Text="Discover Modpacks" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock Text="Search or pick a category above to browse&#x0a;ready-to-play modpack collections" FontSize="12"  Foreground="#6688AA" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="300"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                                    <Border Background="#1A7C4DFF" BorderBrush="#407C4DFF" BorderThickness="1" CornerRadius="8" Padding="12,6" Margin="4,0" Cursor="Hand" x:Name="quickRLCraft" MouseLeftButtonUp="QuickSearch_Click">
                                        <TextBlock Text="⚔️ RLCraft" FontSize="11" Foreground="#7C4DFF"/>
                                    </Border>
                                    <Border Background="#1A62EFAD" BorderBrush="#4062EFAD" BorderThickness="1" CornerRadius="8" Padding="12,6" Margin="4,0" Cursor="Hand" x:Name="quickSkyFactory" MouseLeftButtonUp="QuickSearch_Click">
                                        <TextBlock Text="🌤️ SkyFactory" FontSize="11" Foreground="#62EFAD"/>
                                    </Border>
                                    <Border Background="#1A00B4D8" BorderBrush="#4000B4D8" BorderThickness="1" CornerRadius="8" Padding="12,6" Margin="4,0" Cursor="Hand" x:Name="quickATM" MouseLeftButtonUp="QuickSearch_Click">
                                        <TextBlock Text="⚙️ All the Mods" FontSize="11" Foreground="#00B4D8"/>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- Status bar -->
                <Border Grid.Row="1" Padding="16,8" Background="#060810">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="lbStatus" Grid.Column="0" Text="Ready" FontSize="11" Foreground="#445566" VerticalAlignment="Center"/>
                        <ProgressBar x:Name="pbSearch" Grid.Column="1" Width="100" Height="4" IsIndeterminate="True" Visibility="Collapsed"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Right: Details panel -->
            <Border Grid.Column="1" BorderThickness="1,0,0,0">
                <Border.BorderBrush>
                    <SolidColorBrush Color="#15FFFFFF"/>
                </Border.BorderBrush>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#0B0D1C" Offset="0"/>
                        <GradientStop Color="#090B18" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="16,16,16,8">
                        <StackPanel x:Name="detailsPanel">
                            <!-- Empty state -->
                            <TextBlock Text="📦" FontSize="40" HorizontalAlignment="Center" Margin="0,50,0,12" Opacity="0.3"/>
                            <TextBlock Text="Select a modpack" FontSize="14" FontWeight="SemiBold"
                                       Foreground="#334455" HorizontalAlignment="Center"/>
                            <TextBlock Text="to see details and download" FontSize="11"
                                       Foreground="#2A3550" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Download progress panel -->
                    <Border Grid.Row="1" x:Name="downloadPanel" Visibility="Collapsed" Padding="14,12" Background="#0B0E1E">
                        <Border.BorderBrush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#507C4DFF" Offset="0"/>
                                <GradientStop Color="#5062EFAD" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.BorderBrush>
                        <Border.BorderThickness><Thickness Top="1"/></Border.BorderThickness>
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <TextBlock x:Name="lbDownloadName" Text="Downloading..." FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                                <TextBlock x:Name="lbDownloadPct" Text="0%" FontSize="11" Foreground="#7C4DFF" HorizontalAlignment="Right"/>
                            </Grid>
                            <ProgressBar x:Name="pbDownload" Height="6" Value="0" Maximum="100">
                                <ProgressBar.Foreground>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#7C4DFF" Offset="0"/>
                                        <GradientStop Color="#62EFAD" Offset="1"/>
                                    </LinearGradientBrush>
                                </ProgressBar.Foreground>
                            </ProgressBar>
                            <TextBlock x:Name="lbDownloadSize" Text="" FontSize="10" Foreground="#445566" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══ BOTTOM DOWNLOAD BAR (global, shown during active download) ═══ -->
        <Border Grid.Row="3" x:Name="globalDownloadBar" Visibility="Collapsed" Padding="20,10">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#0D0F20" Offset="0"/>
                    <GradientStop Color="#111428" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#407C4DFF" Offset="0"/>
                    <GradientStop Color="#4062EFAD" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.BorderThickness><Thickness Top="1"/></Border.BorderThickness>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="lbGlobalFile" Text="⬇️ Downloading..." FontSize="12" Foreground="White" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <ProgressBar Grid.Column="1" x:Name="pbGlobalDownload" Height="8" Value="0" Maximum="100" VerticalAlignment="Center">
                    <ProgressBar.Foreground>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#7C4DFF" Offset="0"/>
                            <GradientStop Color="#62EFAD" Offset="1"/>
                        </LinearGradientBrush>
                    </ProgressBar.Foreground>
                </ProgressBar>
                <TextBlock Grid.Column="2" x:Name="lbGlobalPct" Text="0%" FontSize="12" FontWeight="Bold" Foreground="#7C4DFF" VerticalAlignment="Center" Margin="16,0,12,0"/>
                <TextBlock Grid.Column="3" x:Name="lbGlobalSize" Text="" FontSize="11" Foreground="#445566" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Page>
