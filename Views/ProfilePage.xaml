<Page x:Class="MClauncher.Views.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MClauncher.Views"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="1100"
      Title="ProfilePage"
      Loaded="Page_Loaded"
      Background="{DynamicResource ApplicationBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Padding="24,20,24,16" BorderThickness="0,0,0,1">
            <Border.BorderBrush><SolidColorBrush Color="#1A2040"/></Border.BorderBrush>
            <StackPanel Orientation="Horizontal">
                <Border Width="42" Height="42" CornerRadius="11" Margin="0,0,14,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#001828" Offset="0"/>
                            <GradientStop Color="#002840" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" Color="#00B4D8" Opacity="0.35" ShadowDepth="0"/>
                    </Border.Effect>
                    <TextBlock Text="👤" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Player Profile" FontSize="24" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Account details and 3D skin preview" FontSize="11" Foreground="#556677" Margin="0,3,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- MAIN CONTENT -->
        <Grid Grid.Row="1" Margin="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="420"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: Account info -->
            <StackPanel Grid.Column="0" Margin="0,0,20,0">

                <!-- Account Card -->
                <Border CornerRadius="14" Padding="24" Margin="0,0,0,14">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#141826" Offset="0"/>
                            <GradientStop Color="#0F1320" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.BorderBrush><SolidColorBrush Color="#1A2040"/></Border.BorderBrush>
                    <Border.BorderThickness><Thickness>1</Thickness></Border.BorderThickness>

                    <StackPanel>
                        <!-- Label -->
                        <TextBlock Text="ACCOUNT" FontSize="9" FontWeight="Bold" Foreground="#334466" Margin="0,0,0,16"/>

                        <!-- Username big display -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Border Width="48" Height="48" CornerRadius="12" Background="#1500B4D8" Margin="0,0,14,0">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" Color="#00B4D8" Opacity="0.3" ShadowDepth="0"/>
                                </Border.Effect>
                                <TextBlock Text="🎮" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Username" FontSize="10" Foreground="#556677"/>
                                <TextBlock Name="lbUsername" Text="Loading..." FontSize="22" FontWeight="Bold" Foreground="#00B4D8"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Height="1" Background="#0FFFFFFF" Margin="0,16,0,16"/>

                        <!-- Account type badge -->
                        <TextBlock Text="Account Type" FontSize="10" Foreground="#556677" Margin="0,0,0,6"/>
                        <Border Background="#0A62EFAD" BorderBrush="#2062EFAD" BorderThickness="1"
                                CornerRadius="8" Padding="10,6" HorizontalAlignment="Left" Margin="0,0,0,16">
                            <TextBlock Name="lbSessionType" Text="Offline Mode" FontSize="12" FontWeight="SemiBold" Foreground="#62EFAD"/>
                        </Border>

                        <!-- InfoBar for session status -->
                        <ui:InfoBar Name="infoBarStatus" Title="Active Session" Message="Ready to play"
                                    IsClosable="False" Severity="Success" Margin="0,0,0,16"/>

                        <!-- Action buttons -->
                        <StackPanel Orientation="Horizontal">
                            <ui:Button Name="btnRefresh" Content="Refresh Skin" Appearance="Primary" 
                                       Padding="14,9" Click="btnRefresh_Click">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="ArrowSync24"/>
                                </ui:Button.Icon>
                            </ui:Button>
                            <Border Background="#10FFFFFF" CornerRadius="8" Padding="14,9" Margin="10,0,0,0" 
                                    Cursor="Hand" x:Name="btnCopyUsername">
                                <TextBlock Text="📋 Copy Name" FontSize="12" Foreground="#8899BB"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Stats Card -->
                <Border CornerRadius="14" Padding="24">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#141826" Offset="0"/>
                            <GradientStop Color="#0F1320" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.BorderBrush><SolidColorBrush Color="#1A2040"/></Border.BorderBrush>
                    <Border.BorderThickness><Thickness>1</Thickness></Border.BorderThickness>

                    <StackPanel>
                        <TextBlock Text="STATISTICS" FontSize="9" FontWeight="Bold" Foreground="#334466" Margin="0,0,0,16"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <Border Background="#1000B4D8" CornerRadius="8" Width="36" Height="36"
                                        HorizontalAlignment="Left" Margin="0,0,0,8">
                                    <TextBlock Text="📅" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Session created" FontSize="10" Foreground="#556677"/>
                                <TextBlock Name="lbAccountCreated" Text="Today" FontSize="14" FontWeight="Bold" 
                                           Foreground="White" Margin="0,4,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <Border Background="#1062EFAD" CornerRadius="8" Width="36" Height="36"
                                        HorizontalAlignment="Left" Margin="0,0,0,8">
                                    <TextBlock Text="🔄" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Last updated" FontSize="10" Foreground="#556677"/>
                                <TextBlock Name="lbLastUpdated" Text="Just now" FontSize="14" FontWeight="Bold" 
                                           Foreground="White" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- RIGHT: 3D Viewer -->
            <Border Grid.Column="1" CornerRadius="14" ClipToBounds="True">
                <Border.BorderBrush><SolidColorBrush Color="#1A2040"/></Border.BorderBrush>
                <Border.BorderThickness><Thickness>1</Thickness></Border.BorderThickness>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="25" Color="#00B4D8" Opacity="0.1" ShadowDepth="0"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- WebView2 -->
                    <wv2:WebView2 Name="webView" Grid.Row="0"/>

                    <!-- Footer -->
                    <Border Grid.Row="1" Padding="16,12" BorderThickness="0,1,0,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#0C101E" Offset="0"/>
                                <GradientStop Color="#090D18" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.BorderBrush><SolidColorBrush Color="#1A2040"/></Border.BorderBrush>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="3D Character Preview" FontSize="12" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="🖱️ Drag to rotate  •  🔍 Scroll to zoom" FontSize="10" Foreground="#445566" Margin="0,3,0,0"/>
                            </StackPanel>
                            <!-- Glow dot -->
                            <Ellipse Width="8" Height="8" Fill="#62EFAD" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="6" Color="#62EFAD" Opacity="0.8" ShadowDepth="0"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

        </Grid>
    </Grid>
</Page>
