<Page x:Class="MClauncher.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MClauncher.Views"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="1100"
      Title="SettingsPage"
      Loaded="Page_Loaded"
      Background="{DynamicResource ApplicationBackgroundBrush}">

    <Page.Resources>
        <Style x:Key="SettingCardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <!-- ══════════════════════════
                 HEADER
                 ══════════════════════════ -->
            <Border Padding="24,20,24,16" BorderThickness="0,0,0,1">
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="Transparent" Offset="0"/>
                        <GradientStop Color="#2062EFAD" Offset="0.5"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </LinearGradientBrush>
                </Border.BorderBrush>
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="44" Height="44" CornerRadius="12" Margin="0,0,16,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#101828" Offset="0"/>
                                    <GradientStop Color="#182038" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="14" Color="#00B4D8" Opacity="0.35" ShadowDepth="0"/>
                            </Border.Effect>
                            <TextBlock Text="⚙️" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Settings" FontSize="26" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="Configure launcher preferences and game options" FontSize="11" Foreground="#556677" Margin="0,3,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <!-- Save indicator -->
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Fill="#62EFAD" Margin="0,0,7,0" VerticalAlignment="Center">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="5" Color="#62EFAD" Opacity="0.8" ShadowDepth="0"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <TextBlock Text="Auto-saved" FontSize="11" Foreground="#62EFAD" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ══════════════════════════
                 SETTINGS CONTENT
                 ══════════════════════════ -->
            <StackPanel Margin="24,20,24,24">

                <!-- ─── Game Configuration ─── -->
                <Border Style="{StaticResource SettingCardStyle}">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#141826" Offset="0"/>
                            <GradientStop Color="#0F1320" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.BorderBrush><SolidColorBrush Color="#1A2040"/></Border.BorderBrush>
                    <StackPanel>
                        <!-- Section header -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,22">
                            <Border Width="34" Height="34" CornerRadius="9" Background="#1562EFAD" Margin="0,0,12,0">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10" Color="#62EFAD" Opacity="0.3" ShadowDepth="0"/>
                                </Border.Effect>
                                <TextBlock Text="🎮" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Game Configuration" FontSize="15" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="Minecraft path, memory and version options" FontSize="11" Foreground="#556677"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- RAM Allocation -->
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="200"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="RAM Allocation" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                                <TextBlock Text="Memory reserved for Minecraft (512 MB – 32 GB)" FontSize="11" Foreground="#556677" Margin="0,3,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Border Background="#1562EFAD" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                        <TextBlock Text="💡 4096+ MB recommended" FontSize="10" Foreground="#62EFAD"/>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                            <ui:NumberBox Grid.Column="1" Name="nbRam" Value="2048" Minimum="512" Maximum="32768" 
                                          VerticalAlignment="Center" SelectionChanged="nbRam_SelectionChanged"/>
                        </Grid>

                        <Border Height="1" Background="#0FFFFFFF" Margin="0,0,0,20"/>

                        <!-- Snapshots Toggle -->
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Snapshot Versions" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                                <TextBlock Text="Show pre-release and snapshot builds" FontSize="11" Foreground="#556677" Margin="0,3,0,0"/>
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" Name="tsSnapshots" IsChecked="False" 
                                             Checked="tsSnapshots_Changed" Unchecked="tsSnapshots_Changed"/>
                        </Grid>

                        <Border Height="1" Background="#0FFFFFFF" Margin="0,0,0,20"/>

                        <!-- Beta Versions Toggle -->
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Old Beta Versions" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                                <TextBlock Text="Include Alpha and Beta versions from Minecraft's early days" FontSize="11" Foreground="#556677" Margin="0,3,0,0"/>
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" Name="tsBeta" IsChecked="False"/>
                        </Grid>

                        <Border Height="1" Background="#0FFFFFFF" Margin="0,0,0,20"/>

                        <!-- Minecraft Path -->
                        <TextBlock Text="Minecraft Directory" FontSize="13" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,4"/>
                        <TextBlock Text="Location where Minecraft game files are stored" FontSize="11" Foreground="#556677" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" CornerRadius="8" BorderThickness="1" Margin="0,0,10,0" Padding="12,10">
                                <Border.Background><SolidColorBrush Color="#0D1128"/></Border.Background>
                                <Border.BorderBrush><SolidColorBrush Color="#252D50"/></Border.BorderBrush>
                                <ui:TextBox Name="txtPath" Text="%appdata%\.minecraft" Background="Transparent"
                                             BorderThickness="0" IsEnabled="False" Foreground="#8899BB"/>
                            </Border>
                            <ui:Button Grid.Column="1" Content="📁 Browse" Appearance="Secondary" Padding="14,10"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ─── Launch Options ─── -->
                <Border Style="{StaticResource SettingCardStyle}">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#141826" Offset="0"/>
                            <GradientStop Color="#0F1320" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.BorderBrush><SolidColorBrush Color="#1A2040"/></Border.BorderBrush>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,22">
                            <Border Width="34" Height="34" CornerRadius="9" Background="#15FF9800" Margin="0,0,12,0">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10" Color="#FF9800" Opacity="0.3" ShadowDepth="0"/>
                                </Border.Effect>
                                <TextBlock Text="🚀" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Launch Options" FontSize="15" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="What happens when the game starts" FontSize="11" Foreground="#556677"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Close launcher on launch -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Minimize on Launch" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                                <TextBlock Text="Minimize the launcher window when Minecraft starts" FontSize="11" Foreground="#556677" Margin="0,3,0,0"/>
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" Name="tsMinimize" IsChecked="True"/>
                        </Grid>

                        <Border Height="1" Background="#0FFFFFFF" Margin="0,0,0,16"/>

                        <!-- Keep launcher open -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Close on Game Exit" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                                <TextBlock Text="Close the launcher automatically when Minecraft exits" FontSize="11" Foreground="#556677" Margin="0,3,0,0"/>
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" Name="tsCloseOnExit" IsChecked="False"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ─── Appearance ─── -->
                <Border Style="{StaticResource SettingCardStyle}">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#141826" Offset="0"/>
                            <GradientStop Color="#0F1320" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.BorderBrush><SolidColorBrush Color="#1A2040"/></Border.BorderBrush>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,22">
                            <Border Width="34" Height="34" CornerRadius="9" Background="#157C4DFF" Margin="0,0,12,0">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10" Color="#7C4DFF" Opacity="0.3" ShadowDepth="0"/>
                                </Border.Effect>
                                <TextBlock Text="🎨" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Appearance" FontSize="15" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="Theme and visual preferences" FontSize="11" Foreground="#556677"/>
                            </StackPanel>
                        </StackPanel>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Dark Mode" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                                <TextBlock Text="Use dark theme (recommended)" FontSize="11" Foreground="#556677" Margin="0,3,0,0"/>
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" IsChecked="True"/>
                        </Grid>

                        <Border Height="1" Background="#0FFFFFFF" Margin="0,0,0,16"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Mica Transparency" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                                <TextBlock Text="Enable Windows 11 Mica backdrop effect" FontSize="11" Foreground="#556677" Margin="0,3,0,0"/>
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" IsChecked="True"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ─── About / Launcher Info ─── -->
                <Border Style="{StaticResource SettingCardStyle}" Margin="0,0,0,14">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#121A10" Offset="0"/>
                            <GradientStop Color="#0E1510" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.BorderBrush><SolidColorBrush Color="#1A3020"/></Border.BorderBrush>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                            <Border Width="34" Height="34" CornerRadius="9" Background="#154CAF50" Margin="0,0,12,0">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10" Color="#4CAF50" Opacity="0.35" ShadowDepth="0"/>
                                </Border.Effect>
                                <TextBlock Text="ℹ️" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="About Nexus Launcher" FontSize="15" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="Version info and credits" FontSize="11" Foreground="#556677"/>
                            </StackPanel>
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="VERSION" FontSize="9" FontWeight="Bold" Foreground="#334466" Margin="0,0,0,5"/>
                                <TextBlock Text="1.0.3" FontSize="18" FontWeight="Bold" Foreground="#62EFAD"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="PLATFORM" FontSize="9" FontWeight="Bold" Foreground="#334466" Margin="0,0,0,5"/>
                                <TextBlock Text=".NET 8 WPF" FontSize="18" FontWeight="Bold" Foreground="White"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="THEME" FontSize="9" FontWeight="Bold" Foreground="#334466" Margin="0,0,0,5"/>
                                <TextBlock Text="Fluent Dark" FontSize="18" FontWeight="Bold" Foreground="White"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ─── Danger Zone ─── -->
                <Border Style="{StaticResource SettingCardStyle}" Margin="0,0,0,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#1A0A0A" Offset="0"/>
                            <GradientStop Color="#140808" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.BorderBrush><SolidColorBrush Color="#3A1515"/></Border.BorderBrush>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                            <Border Width="34" Height="34" CornerRadius="9" Background="#20FF5252" Margin="0,0,12,0">
                                <TextBlock Text="⚠️" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Danger Zone" FontSize="15" FontWeight="Bold" Foreground="#FF5252"/>
                                <TextBlock Text="Irreversible actions — proceed with caution" FontSize="11" Foreground="#664444"/>
                            </StackPanel>
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Reset to Defaults" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                                <TextBlock Text="Restore all settings to factory defaults" FontSize="11" Foreground="#664444" Margin="0,3,0,0"/>
                            </StackPanel>
                            <ui:Button Grid.Column="1" Name="btnResetSettings" Content="Reset" 
                                       Appearance="Secondary" Padding="14,9" Click="btnResetSettings_Click">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="ArrowSync24"/>
                                </ui:Button.Icon>
                            </ui:Button>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
